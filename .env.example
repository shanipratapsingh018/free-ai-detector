# Variable NAMES only. Never commit real values.
# Local dev: copy to .dev.vars (git-ignored) and fill in. Production: `npx wrangler secret put NAME`.

# --- AI detector (required for scores) ---
GPTZERO_API_KEY=
# Optional: pin a detector version for comparable results (see GET /v2/model-versions/ai-scan)
GPTZERO_MODEL_VERSION=
# Optional: "true" to use GPTZero's multilingual model (ignored if GPTZERO_MODEL_VERSION is set)
GPTZERO_MULTILINGUAL=

# --- Language model for Humanize / Grammar / Simplify / Summarize (set ONE provider) ---
# Optional: "openai" or "anthropic". If empty, the first provider with a key is used (OpenAI first).
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Cost / abuse controls (non-secret; defaults shown in wrangler.jsonc / code) ---
RATE_LIMIT_PER_MINUTE=
DAILY_DETECT_LIMIT=
DAILY_REVISE_LIMIT=
DETECTOR_ENABLED=
WRITER_ENABLED=
DETECTOR_TIMEOUT_MS=
LLM_TIMEOUT_MS=
LLM_MAX_OUTPUT_TOKENS=
