{
  "name": "free-ai-detector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "npm run build && node --test tests/e2e/*.test.js",
    "check": "node --check public/app.js && node --check public/extract.js && node --check worker/index.js",
    "deploy:dry": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "pdfjs-dist": "^5.7.284"
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "playwright": "^1.65.1",
    "wrangler": "^4.163.0"
  },
  "engines": {
    "node": ">=20"
  }
}
